<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_RCA_ASIS"
                  targetNamespace="http://utair.aero/bpmn/tsup">
  <bpmn:collaboration id="Collab_RCA">
    <bpmn:participant id="Pool_TsUP_RCA" name="Цикл RCA по задержкам рейсов (AS-IS)" processRef="Proc_RCA"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_RCA" isExecutable="false">
    <bpmn:laneSet id="LaneSet_RCA">
      <bpmn:lane id="Lane_Sources" name="Источники события (AFTN / SITA / Ю-Ти-Джи / КВС)">
        <bpmn:flowNodeRef>Start_Delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AFTN</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Disp" name="Диспетчер ЦУП (DP A1)">
        <bpmn:flowNodeRef>Task_A1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NS" name="НС ЦУП (DP A2)">
        <bpmn:flowNodeRef>Task_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report_101</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Head" name="Начальник ЦУП (DP A3)">
        <bpmn:flowNodeRef>Task_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Investigate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GenDir" name="Начальник ЦУП → Ген.директор (DP A4)">
        <bpmn:flowNodeRef>Task_Aggregate_106</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Loop</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Delay" name="Факт. вылет / посадка / задержка"/>
    <bpmn:task id="Task_AFTN" name="Получение MVT / AFTN / SITA / сообщений Ю-Ти-Джи"/>
    <bpmn:task id="Task_A1" name="A1: Предв. формулировка причины + IATA-код (≤15 мин)"/>
    <bpmn:task id="Task_A2" name="A2: Окончат. формулировка + код AHM 730 (РД-Б8.005-09 §14.2)"/>
    <bpmn:task id="Task_Report_101" name="Сменный отчёт UT-DSP.1-01.1 (04:00 / 16:00 МСК)"/>
    <bpmn:task id="Task_A3" name="A3: Анализ материалов (до 11:00 тюм. ежедневно)"/>
    <bpmn:exclusiveGateway id="Gw_Investigate" name="Нужно расследование?"/>
    <bpmn:task id="Task_Notify" name="Lotus Notes: уведомление руководителям подразделений-виновников"/>
    <bpmn:task id="Task_Aggregate_106" name="Накопление в ИС «Производственная отчётность» → UT-DSP.1-06"/>
    <bpmn:task id="Task_A4" name="A4: Корректирующие/предупреждающие действия (ДП-М1.003)"/>
    <bpmn:endEvent id="End_Loop" name="Изменение процедур / спец.аудит подрядчика"/>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_Delay" targetRef="Task_AFTN"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_AFTN" targetRef="Task_A1"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_A1" targetRef="Task_A2"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_A2" targetRef="Task_Report_101"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Report_101" targetRef="Task_A3"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_A3" targetRef="Gw_Investigate"/>
    <bpmn:sequenceFlow id="F7" name="да" sourceRef="Gw_Investigate" targetRef="Task_Notify"/>
    <bpmn:sequenceFlow id="F8" name="нет" sourceRef="Gw_Investigate" targetRef="Task_Aggregate_106"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Notify" targetRef="Task_Aggregate_106"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Aggregate_106" targetRef="Task_A4"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_A4" targetRef="End_Loop"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diag_RCA">
    <bpmndi:BPMNPlane id="Plane_RCA" bpmnElement="Collab_RCA">
      <bpmndi:BPMNShape id="S_Pool" bpmnElement="Pool_TsUP_RCA" isHorizontal="true">
        <dc:Bounds x="120" y="60" width="1480" height="650"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Sources" bpmnElement="Lane_Sources" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="1450" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Disp" bpmnElement="Lane_Disp" isHorizontal="true">
        <dc:Bounds x="150" y="180" width="1450" height="110"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_NS" bpmnElement="Lane_NS" isHorizontal="true">
        <dc:Bounds x="150" y="290" width="1450" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Head" bpmnElement="Lane_Head" isHorizontal="true">
        <dc:Bounds x="150" y="410" width="1450" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_GenDir" bpmnElement="Lane_GenDir" isHorizontal="true">
        <dc:Bounds x="150" y="550" width="1450" height="160"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_Start" bpmnElement="Start_Delay">
        <dc:Bounds x="200" y="100" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="180" y="140" width="80" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_AFTN" bpmnElement="Task_AFTN">
        <dc:Bounds x="290" y="90" width="160" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A1" bpmnElement="Task_A1">
        <dc:Bounds x="500" y="200" width="190" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A2" bpmnElement="Task_A2">
        <dc:Bounds x="730" y="310" width="200" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Report" bpmnElement="Task_Report_101">
        <dc:Bounds x="970" y="310" width="180" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A3" bpmnElement="Task_A3">
        <dc:Bounds x="500" y="440" width="200" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw" bpmnElement="Gw_Investigate" isMarkerVisible="true">
        <dc:Bounds x="740" y="455" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="720" y="500" width="80" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Notify" bpmnElement="Task_Notify">
        <dc:Bounds x="820" y="440" width="200" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Agg" bpmnElement="Task_Aggregate_106">
        <dc:Bounds x="500" y="590" width="220" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A4" bpmnElement="Task_A4">
        <dc:Bounds x="760" y="590" width="220" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End" bpmnElement="End_Loop">
        <dc:Bounds x="1030" y="608" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1075" y="615" width="200" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_F1" bpmnElement="F1">
        <di:waypoint x="236" y="118"/><di:waypoint x="290" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F2" bpmnElement="F2">
        <di:waypoint x="370" y="150"/><di:waypoint x="370" y="200"/><di:waypoint x="500" y="235"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F3" bpmnElement="F3">
        <di:waypoint x="690" y="270"/><di:waypoint x="690" y="310"/><di:waypoint x="730" y="345"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F4" bpmnElement="F4">
        <di:waypoint x="930" y="345"/><di:waypoint x="970" y="345"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F5" bpmnElement="F5">
        <di:waypoint x="1060" y="380"/><di:waypoint x="1060" y="420"/><di:waypoint x="600" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F6" bpmnElement="F6">
        <di:waypoint x="700" y="475"/><di:waypoint x="740" y="475"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F7" bpmnElement="F7">
        <di:waypoint x="780" y="475"/><di:waypoint x="820" y="475"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F8" bpmnElement="F8">
        <di:waypoint x="760" y="495"/><di:waypoint x="760" y="560"/><di:waypoint x="610" y="590"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F9" bpmnElement="F9">
        <di:waypoint x="920" y="510"/><di:waypoint x="920" y="560"/><di:waypoint x="710" y="590"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F10" bpmnElement="F10">
        <di:waypoint x="720" y="625"/><di:waypoint x="760" y="625"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F11" bpmnElement="F11">
        <di:waypoint x="980" y="625"/><di:waypoint x="1030" y="625"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
