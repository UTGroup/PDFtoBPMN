<?xml version="1.0" encoding="UTF-8"?>
<!--
  LEGACY (v1.0): «Цикл оптимизации в сбойной ситуации» (триггер ≥10 задержек, ERP/RG-128).
  В аналитике v2.1 этот контур ВЫНЕСЕН ИЗ ОСНОВНОЙ B-ПЕТЛИ:
    - Сбойная ситуация по §15.1.3.3 — фаза 2 (плейбуки КК62-26 поверх B-петли).
    - ERP / РГ-128 — полностью out-of-scope ИИ-ассистента.
  Актуальная модель — в Operational_Regularity_AS-IS.bpmn (этот же каталог).
  Файл сохранён как ссылочный для legacy-сценария / историческая фиксация AS-IS v1.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Disrupt_ASIS"
                  targetNamespace="http://utair.aero/bpmn/tsup">
  <bpmn:collaboration id="Collab_Disrupt">
    <bpmn:participant id="Pool_TsUP_Disrupt" name="Цикл оптимизации в сбойной ситуации (AS-IS)" processRef="Proc_Disrupt"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_Disrupt" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Disrupt">
      <bpmn:lane id="Lane_Inputs" name="Многофакторные входы (метео, парк, экипажи, маршруты, наземное обсл., коммерц., слоты, заявки)">
        <bpmn:flowNodeRef>Start_Track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Aggregate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NS_D" name="НС ЦУП (DP B1, B2)">
        <bpmn:flowNodeRef>Gw_Trigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Head_D" name="Начальник ЦУП (согласование B2 / эскалация B4)">
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ANV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Exec" name="Исполнители (Meridian.Ops, Ю-Ти-Джи 148-08, ЦУТО ВС, СПиОУ, ДОНО, ДУТиЗ)">
        <bpmn:flowNodeRef>Task_Exec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify_SMS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mgr_Sched" name="Менеджер по управлению расписанием (DP B3)">
        <bpmn:flowNodeRef>Task_B3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Recovery</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ERP" name="Оперштаб ERP (РГ-128) — внешний контур">
        <bpmn:flowNodeRef>End_ERP</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Track" name="Отслеживание ВС / событий в плане"/>
    <bpmn:task id="Task_Aggregate" name="Сбор многофакторных входов (метео, AOG, экипажи, слоты, коммерц.)"/>
    <bpmn:exclusiveGateway id="Gw_Trigger" name="≥10 задержек по одной причине? (§15.1.3.3.2)"/>
    <bpmn:task id="Task_B1" name="B1: Присвоение статуса «Сбойная ситуация», вызов руководителей"/>
    <bpmn:task id="Task_B2" name="B2: Выбор сценария — ≥2 варианта (замена ВС / запасной / отмена / совмещение / приоритеты)"/>
    <bpmn:task id="Task_Approve" name="Согласование сценария начальником ЦУП"/>
    <bpmn:task id="Task_Exec" name="Команды: Meridian.Ops, ЦУТО ВС, СПиОУ, ДОНО, Ю-Ти-Джи (148-08 п.4)"/>
    <bpmn:task id="Task_Notify_SMS" name="СМС-рассылки «&gt;2 ч» / «ВИП», РД в МТУ Росавиации"/>
    <bpmn:task id="Task_B3" name="B3: Recovery-оптимизация на 72 часа (СПП на след. сутки)"/>
    <bpmn:exclusiveGateway id="Gw_ANV" name="АНВ / АП / кризис?"/>
    <bpmn:task id="Task_B4" name="B4: Эскалация в оперштаб ERP (РГ-128 §1.1, §5.6–5.7)"/>
    <bpmn:endEvent id="End_Recovery" name="Возврат в норм. режим"/>
    <bpmn:endEvent id="End_ERP" name="Кризисный режим: МТУ / ФАВТ / МАК / СМИ"/>

    <bpmn:sequenceFlow id="D1" sourceRef="Start_Track" targetRef="Task_Aggregate"/>
    <bpmn:sequenceFlow id="D2" sourceRef="Task_Aggregate" targetRef="Gw_Trigger"/>
    <bpmn:sequenceFlow id="D3" name="да" sourceRef="Gw_Trigger" targetRef="Task_B1"/>
    <bpmn:sequenceFlow id="D4" name="нет" sourceRef="Gw_Trigger" targetRef="Task_Aggregate"/>
    <bpmn:sequenceFlow id="D5" sourceRef="Task_B1" targetRef="Task_B2"/>
    <bpmn:sequenceFlow id="D6" sourceRef="Task_B2" targetRef="Task_Approve"/>
    <bpmn:sequenceFlow id="D7" sourceRef="Task_Approve" targetRef="Gw_ANV"/>
    <bpmn:sequenceFlow id="D8" name="нет" sourceRef="Gw_ANV" targetRef="Task_Exec"/>
    <bpmn:sequenceFlow id="D9" name="да" sourceRef="Gw_ANV" targetRef="Task_B4"/>
    <bpmn:sequenceFlow id="D10" sourceRef="Task_Exec" targetRef="Task_Notify_SMS"/>
    <bpmn:sequenceFlow id="D11" sourceRef="Task_Notify_SMS" targetRef="Task_B3"/>
    <bpmn:sequenceFlow id="D12" sourceRef="Task_B3" targetRef="End_Recovery"/>
    <bpmn:sequenceFlow id="D13" sourceRef="Task_B4" targetRef="End_ERP"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diag_Disrupt">
    <bpmndi:BPMNPlane id="Plane_Disrupt" bpmnElement="Collab_Disrupt">
      <bpmndi:BPMNShape id="DS_Pool" bpmnElement="Pool_TsUP_Disrupt" isHorizontal="true">
        <dc:Bounds x="120" y="60" width="1700" height="800"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Lane_Inputs" bpmnElement="Lane_Inputs" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="1670" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Lane_NS_D" bpmnElement="Lane_NS_D" isHorizontal="true">
        <dc:Bounds x="150" y="190" width="1670" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Lane_Head_D" bpmnElement="Lane_Head_D" isHorizontal="true">
        <dc:Bounds x="150" y="330" width="1670" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Lane_Exec" bpmnElement="Lane_Exec" isHorizontal="true">
        <dc:Bounds x="150" y="470" width="1670" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Lane_Mgr" bpmnElement="Lane_Mgr_Sched" isHorizontal="true">
        <dc:Bounds x="150" y="610" width="1670" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Lane_ERP" bpmnElement="Lane_ERP" isHorizontal="true">
        <dc:Bounds x="150" y="730" width="1670" height="130"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DS_Start" bpmnElement="Start_Track">
        <dc:Bounds x="200" y="105" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="180" y="145" width="100" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Agg" bpmnElement="Task_Aggregate">
        <dc:Bounds x="290" y="95" width="220" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Gw" bpmnElement="Gw_Trigger" isMarkerVisible="true">
        <dc:Bounds x="560" y="240" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="540" y="285" width="200" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_B1" bpmnElement="Task_B1">
        <dc:Bounds x="650" y="220" width="220" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_B2" bpmnElement="Task_B2">
        <dc:Bounds x="900" y="220" width="260" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Approve" bpmnElement="Task_Approve">
        <dc:Bounds x="900" y="360" width="260" height="70"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_GwANV" bpmnElement="Gw_ANV" isMarkerVisible="true">
        <dc:Bounds x="1200" y="380" width="40" height="40"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1180" y="425" width="100" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_B4" bpmnElement="Task_B4">
        <dc:Bounds x="1280" y="360" width="260" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Exec" bpmnElement="Task_Exec">
        <dc:Bounds x="900" y="500" width="280" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_SMS" bpmnElement="Task_Notify_SMS">
        <dc:Bounds x="1230" y="500" width="240" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_B3" bpmnElement="Task_B3">
        <dc:Bounds x="1230" y="630" width="280" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_End" bpmnElement="End_Recovery">
        <dc:Bounds x="1560" y="654" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1605" y="660" width="120" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_End_ERP" bpmnElement="End_ERP">
        <dc:Bounds x="1380" y="770" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1425" y="780" width="220" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="DE_D1" bpmnElement="D1">
        <di:waypoint x="236" y="123"/><di:waypoint x="290" y="125"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D2" bpmnElement="D2">
        <di:waypoint x="510" y="125"/><di:waypoint x="580" y="125"/><di:waypoint x="580" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D3" bpmnElement="D3">
        <di:waypoint x="600" y="260"/><di:waypoint x="650" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D4" bpmnElement="D4">
        <di:waypoint x="580" y="240"/><di:waypoint x="580" y="200"/><di:waypoint x="400" y="155"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D5" bpmnElement="D5">
        <di:waypoint x="870" y="260"/><di:waypoint x="900" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D6" bpmnElement="D6">
        <di:waypoint x="1030" y="300"/><di:waypoint x="1030" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D7" bpmnElement="D7">
        <di:waypoint x="1160" y="395"/><di:waypoint x="1200" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D8" bpmnElement="D8">
        <di:waypoint x="1220" y="420"/><di:waypoint x="1220" y="500"/><di:waypoint x="1180" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D9" bpmnElement="D9">
        <di:waypoint x="1240" y="400"/><di:waypoint x="1280" y="400"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D10" bpmnElement="D10">
        <di:waypoint x="1180" y="540"/><di:waypoint x="1230" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D11" bpmnElement="D11">
        <di:waypoint x="1350" y="580"/><di:waypoint x="1350" y="630"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D12" bpmnElement="D12">
        <di:waypoint x="1510" y="670"/><di:waypoint x="1560" y="672"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DE_D13" bpmnElement="D13">
        <di:waypoint x="1410" y="440"/><di:waypoint x="1410" y="770"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
