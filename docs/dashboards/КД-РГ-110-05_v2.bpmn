<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Part_Control" name="Корпоративный контроль над ДЗ, КЗ и ТМЦ (КД-РГ-110-05)" processRef="Proc_Control" />
    <bpmn:participant id="Part_KBII" name="КБИИ (Комитет по бюджету, инновациям и инвестициям)" processRef="Proc_KBII" />
    <bpmn:messageFlow id="MF_1" name="Рекомендации и поручения" sourceRef="Task_KBII_Dir" targetRef="Task_ApproveKPI" />
  </bpmn:collaboration>

  <!-- ══ MAIN PROCESS ══ -->
  <bpmn:process id="Proc_Control" isExecutable="false">
    <bpmn:laneSet id="LS_1">
      <bpmn:lane id="Lane_KEIF" name="КЭиФ (Комитет по экономике и финансам)">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveKPI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OSKO" name="Начальник ОСКО">
        <bpmn:flowNodeRef>Task_Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ForkPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ForkExec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_JoinExec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Control</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EU" name="Ответственный сотрудник ЭУ">
        <bpmn:flowNodeRef>GW_JoinCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Comp" name="Руководители Компаний">
        <bpmn:flowNodeRef>Task_DataC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecC</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PFM" name="Руководители ПФМ Авиакомпании">
        <bpmn:flowNodeRef>Task_DataP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecP</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="Закрытие бухгалтерской отчётности">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Select" name="Определение объектов Контроля">
      <bpmn:documentation>КД-РГ-110-05, п.7.2
Определение Компаний и ПФМ, ДЗ/КЗ/ТМЦ которых подлежат Контролю в текущем цикле. Выбор с учётом влияния на денежные потоки Группы, доли в объёме задолженности, стратегических задач.
Ответственный: КЭиФ</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Plan" name="Планирование и организация заседания КЭиФ">
      <bpmn:documentation>КД-РГ-110-05, п.7.3
Организация заседания КЭиФ по рассмотрению ДЗ/КЗ/ТМЦ в соответствии с Положением о КЭиФ. Определение повестки, участников, даты.
Ответственный: Начальник ОСКО</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="GW_ForkPrep" name="Параллельная подготовка">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_DataC" name="Выгрузка и проверка данных Компаний">
      <bpmn:documentation>КД-РГ-110-05, п.7.6
Выгрузка данных из учётной системы (бухучёт), проверка и устранение выявленных ошибок. Подготовка данных о ДЗ/КЗ/ТМЦ Компаний.
Ответственный: Руководители Компаний</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_DataP" name="Выгрузка и проверка данных ПФМ">
      <bpmn:documentation>КД-РГ-110-05, п.7.6
Выгрузка данных из учётной системы (бухучёт), проверка и устранение выявленных ошибок. Подготовка данных о ДЗ/КЗ/ТМЦ ПФМ.
Ответственный: Руководители ПФМ</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AnalC" name="Анализ и подготовка материалов Компаний">
      <bpmn:documentation>КД-РГ-110-05, п.7.6-7.7
Анализ данных и подготовка материалов к докладу КЭиФ: презентация, таблицы Excel, графики, расшифровки.
Ответственный: Руководители Компаний</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_AnalP" name="Анализ и подготовка материалов ПФМ">
      <bpmn:documentation>КД-РГ-110-05, п.7.6-7.7
Анализ данных и подготовка материалов к докладу КЭиФ: презентация, таблицы Excel, графики, расшифровки.
Ответственный: Руководители ПФМ</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="GW_JoinCheck" name="Синхронизация">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_Check" name="Проверка расчётов контрольных показателей">
      <bpmn:documentation>КД-РГ-110-05, п.6.4, 7.7
Проверка расчёта нормативных значений контрольных показателей по ДЗ/КЗ/ТМЦ. Методическое обеспечение при подготовке материалов к заседаниям КЭиФ.
Ответственный: Ответственный сотрудник ЭУ</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Meeting" name="Рассмотрение материалов на заседании КЭиФ">
      <bpmn:documentation>КД-РГ-110-05, п.7.5
Рассмотрение состояния ДЗ/КЗ/ТМЦ на отчётную дату, динамики, причин изменений, уровня и причин просроченной задолженности. Оценка результатов работы Компаний/ПФМ с контрагентами.
Ответственный: КЭиФ</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ApproveKPI" name="Утверждение КП и нормативов, выдача поручений">
      <bpmn:documentation>КД-РГ-110-05, п.7.5
Утверждение контрольных показателей и нормативных значений. Рассмотрение отклонений факта от нормативов. Выдача поручений по корректирующим мероприятиям. Учёт рекомендаций КБИИ.
Ответственный: КЭиФ</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Protocol" name="Протоколирование и рассылка решений">
      <bpmn:documentation>КД-РГ-110-05, п.7.3 + Положение о КЭиФ
Протоколирование решений КЭиФ и рассылка протокола ответственным лицам.
Ответственный: Начальник ОСКО</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="GW_ForkExec" name="Параллельное исполнение">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_ExecC" name="Исполнение решений КЭиФ Компаниями">
      <bpmn:documentation>КД-РГ-110-05, п.6.5
Исполнение поручений КЭиФ в установленные сроки. Обеспечение соблюдения нормативных уровней контрольных показателей.
Ответственный: Руководители Компаний</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ExecP" name="Исполнение решений КЭиФ ПФМ">
      <bpmn:documentation>КД-РГ-110-05, п.6.5
Исполнение поручений КЭиФ в установленные сроки. Обеспечение соблюдения нормативных уровней контрольных показателей.
Ответственный: Руководители ПФМ</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:parallelGateway id="GW_JoinExec" name="Синхронизация исполнения">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_Control" name="Контроль исполнения решений">
      <bpmn:documentation>КД-РГ-110-05, п.7.3-7.4
Мониторинг исполнения поручений КЭиФ: сроки, качество выполнения. Подготовка информации для следующего цикла контроля.
Ответственный: Начальник ОСКО</bpmn:documentation>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_Cycle" name="Следующий цикл?" default="F22">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_1" name="Процесс завершён">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Select" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Select" targetRef="Task_Plan" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Plan" targetRef="GW_ForkPrep" />
    <bpmn:sequenceFlow id="F4" sourceRef="GW_ForkPrep" targetRef="Task_DataC" />
    <bpmn:sequenceFlow id="F5" sourceRef="GW_ForkPrep" targetRef="Task_DataP" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_DataC" targetRef="Task_AnalC" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_DataP" targetRef="Task_AnalP" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_AnalC" targetRef="GW_JoinCheck" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_AnalP" targetRef="GW_JoinCheck" />
    <bpmn:sequenceFlow id="F10" sourceRef="GW_JoinCheck" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Check" targetRef="Task_Meeting" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Meeting" targetRef="Task_ApproveKPI" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_ApproveKPI" targetRef="Task_Protocol" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Protocol" targetRef="GW_ForkExec" />
    <bpmn:sequenceFlow id="F15" sourceRef="GW_ForkExec" targetRef="Task_ExecC" />
    <bpmn:sequenceFlow id="F16" sourceRef="GW_ForkExec" targetRef="Task_ExecP" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_ExecC" targetRef="GW_JoinExec" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_ExecP" targetRef="GW_JoinExec" />
    <bpmn:sequenceFlow id="F19" sourceRef="GW_JoinExec" targetRef="Task_Control" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Control" targetRef="GW_Cycle" />
    <bpmn:sequenceFlow id="F21" name="Да (следующий цикл)" sourceRef="GW_Cycle" targetRef="Task_Plan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">nextCycle</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F22" name="Нет (конец периода)" sourceRef="GW_Cycle" targetRef="End_1" />
  </bpmn:process>

  <!-- ══ КБИИ PROCESS ══ -->
  <bpmn:process id="Proc_KBII" isExecutable="false">
    <bpmn:startEvent id="Start_K" name="Отчётный период">
      <bpmn:outgoing>FK1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_KBII_Rev" name="Рассмотрение отчёта по оборотному капиталу">
      <bpmn:documentation>Положение о КБИИ
Рассмотрение отчёта по оборотному капиталу в контексте стратегии и целевых параметров деятельности ПФМ и обществ Группы.
Ответственный: КБИИ</bpmn:documentation>
      <bpmn:incoming>FK1</bpmn:incoming>
      <bpmn:outgoing>FK2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_KBII_Dir" name="Поручения и рекомендации">
      <bpmn:documentation>Положение о КБИИ, п.2.3
Поручения и рекомендации по формату отчётности, периодичности контроля, целевым параметрам. Координация с КЭиФ по вопросам оборотного капитала.
Ответственный: КБИИ</bpmn:documentation>
      <bpmn:incoming>FK2</bpmn:incoming>
      <bpmn:outgoing>FK3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_K" name="Решения доведены">
      <bpmn:incoming>FK3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FK1" sourceRef="Start_K" targetRef="Task_KBII_Rev" />
    <bpmn:sequenceFlow id="FK2" sourceRef="Task_KBII_Rev" targetRef="Task_KBII_Dir" />
    <bpmn:sequenceFlow id="FK3" sourceRef="Task_KBII_Dir" targetRef="End_K" />
  </bpmn:process>

  <!-- ══ DIAGRAM ══ -->
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">

      <!-- Pools -->
      <bpmndi:BPMNShape id="Part_Control_di" bpmnElement="Part_Control" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="3000" height="820" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_KBII_di" bpmnElement="Part_KBII" isHorizontal="true">
        <dc:Bounds x="160" y="960" width="3000" height="130" />
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape id="Lane_KEIF_di" bpmnElement="Lane_KEIF" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2970" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OSKO_di" bpmnElement="Lane_OSKO" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2970" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_EU_di" bpmnElement="Lane_EU" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="2970" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Comp_di" bpmnElement="Lane_Comp" isHorizontal="true">
        <dc:Bounds x="190" y="560" width="2970" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_PFM_di" bpmnElement="Lane_PFM" isHorizontal="true">
        <dc:Bounds x="190" y="720" width="2970" height="180" />
      </bpmndi:BPMNShape>

      <!-- Main process shapes -->
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="270" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="244" y="195" width="88" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Select_di" bpmnElement="Task_Select">
        <dc:Bounds x="370" y="130" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Plan_di" bpmnElement="Task_Plan">
        <dc:Bounds x="580" y="300" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ForkPrep_di" bpmnElement="GW_ForkPrep">
        <dc:Bounds x="790" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DataC_di" bpmnElement="Task_DataC">
        <dc:Bounds x="890" y="600" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DataP_di" bpmnElement="Task_DataP">
        <dc:Bounds x="890" y="770" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AnalC_di" bpmnElement="Task_AnalC">
        <dc:Bounds x="1110" y="600" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AnalP_di" bpmnElement="Task_AnalP">
        <dc:Bounds x="1110" y="770" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_JoinCheck_di" bpmnElement="GW_JoinCheck">
        <dc:Bounds x="1330" y="465" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check">
        <dc:Bounds x="1430" y="450" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Meeting_di" bpmnElement="Task_Meeting">
        <dc:Bounds x="1660" y="130" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveKPI_di" bpmnElement="Task_ApproveKPI">
        <dc:Bounds x="1870" y="130" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Protocol_di" bpmnElement="Task_Protocol">
        <dc:Bounds x="2100" y="300" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ForkExec_di" bpmnElement="GW_ForkExec">
        <dc:Bounds x="2310" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecC_di" bpmnElement="Task_ExecC">
        <dc:Bounds x="2410" y="600" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecP_di" bpmnElement="Task_ExecP">
        <dc:Bounds x="2410" y="770" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_JoinExec_di" bpmnElement="GW_JoinExec">
        <dc:Bounds x="2630" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Control_di" bpmnElement="Task_Control">
        <dc:Bounds x="2730" y="300" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Cycle_di" bpmnElement="GW_Cycle" isMarkerVisible="true">
        <dc:Bounds x="2940" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="2920" y="115" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
